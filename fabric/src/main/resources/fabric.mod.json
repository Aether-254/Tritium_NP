{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/CraftAmethyst/Tritium"
  },
  "license": "${license}",
  "icon": "assets/tritium/textures/gui/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.craftamethyst.tritium.TritiumFabric"
    ],
    "client": [
      "org.craftamethyst.tritium.client.TritiumFabricClient"
    ],
    "modmenu": [
      "org.craftamethyst.tritium.integration.modmenu.ModMenuIntegration"
    ]
  },
  "mixins": [
    "tritium.mixins.json",
    "tritium.compat.mixins.json",
    "tritium.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=1.21.2 <1.21.4",
    "cloth-config": ">=15",
    "modmenu": "*",
    "java": ">=${java_version}"
  },
  "suggests": {
    "another-mod": "*"
  }
}
